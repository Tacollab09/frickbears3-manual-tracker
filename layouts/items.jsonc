  "settings_grid": {
    "type": "array",
    "orientation": "vertical",
    "margin": "2,2",
    "content": [
      {
        "type": "itemgrid",
        "item_margin": "2, 2",
        "item_size": 4,
        "margin": "0,0",
        "h_alignment": "center",
        "rows": [
          ["death","cadetstories", "chardiff", "goal"]
