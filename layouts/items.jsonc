                "power_hour_upgrade",
                "late_start_upgrade",
                "tasty_investment_upgrade",
                "upgrade_commander_upgrade",
                "all_ears_upgrade",
                "employee_discount_upgrade",
                "cam_radar_upgrade",
                "overstock_upgrade",
                "power_ac_upgrade",
                "spawnkiller_upgrade",
                "mangle_cart",
                "anim_cart"
              ]
            ]
          }
        ]
      }
    ]
  },
  "shop_grid": {
    "type": "array",
    "orientation": "vertical",
    "margin": "0,0",
    "content": [
      {
        "type": "array",
        "orientation": "horizontal",
        "margin": "0,0",
        "content": [
          {
            "type": "itemgrid",
            "item_margin": "2, 2",
            "item_size": 4,
            "h_alignment": "left",
            "rows": [
              [
                "mimic_ball_shop",
                "kings_prize_shop_1",
                "rewind_clock_shop_1",
                "battery_pack_shop_1",
                "snowcone_shop_1",
                "golden_cupcake_shop_1",
                "token"

              ],
