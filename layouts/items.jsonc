                "laser_doors_shop_1",
                "bear_trap_shop",
                "death_coin_shop",
                "distortion_clock_shop_1",
                "pickles_shop",
                "chipper_lumber_shop"
              ]
            ]
          }
        ]
      }
    ]
  },
    "evil_ending": {
    "type": "array",
    "orientation": "vertical",
    "margin": "0,0",
    "content": [
      {
        "type": "array",
        "orientation": "horizontal",
        "margin": "0,0",
        "content": [
          {
            "type": "itemgrid",
            "item_margin": "2,2",
            "item_size": 4,
            "h_alignment": "left",
