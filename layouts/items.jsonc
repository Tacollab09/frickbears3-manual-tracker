{
  // sets layouts for shadred items grids
  // bigger example: https://github.com/Cyb3RGER/sm_ap_tracker/blob/main/layouts/items.json
  "good_ending": {
    "type": "array",
    "orientation": "vertical",
    "margin": "0,0",
    "content": [
      {
        "type": "array",
        "orientation": "horizontal",
        "margin": "0,0",
        "content": [
          {
            "type": "itemgrid",
            "item_margin": "2, 2",
            "item_size": 4,
            "h_alignment": "left",
            "rows": [
              [
                "freddy_mask_key",
                "bonnie_mask_key",
                "progressive_present"

              ],
              [                
                "chica_mask_key",
                "foxy_mask_key",
                "talbert_files"
              ]
            ]
          }
        ]
      }
    ]
  },
  "upgrades_grid": {
    "type": "array",
    "orientation": "vertical",
    "margin": "0,0",
    "content": [
      {
        "type": "array",
        "orientation": "horizontal",
        "margin": "0,0",
        "content": [
          {
            "type": "itemgrid",
            "item_margin": "2, 2",
            "item_size": 4,
            "h_alignment": "left",
            "rows": [
              [
                "overcharge_upgrade",
